# HTTP port the app listens on
PORT=3000

# Where the SQLite database file is written (persistent audit log)
DB_PATH=data/document-viewer.sqlite

# Base URLs for the two upstream document-source systems.
# In THIS assessment they are mocked inside this same service, so they
# point back at the app's own /v1/mock/* routes. In a real deployment
# these would point at the actual external Sales/Service system hosts and
# would NOT include a version segment.
SALES_SYSTEM_BASE_URL=http://localhost:3000
SERVICE_SYSTEM_BASE_URL=http://localhost:3000

# Per-call timeout (ms) before a client call counts as a failure
SALES_SYSTEM_TIMEOUT_MS=3000
SERVICE_SYSTEM_TIMEOUT_MS=3000

NODE_ENV=development
