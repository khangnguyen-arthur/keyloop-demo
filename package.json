{
  "name": "keyloop-unified-document-viewer",
  "version": "1.0.0",
  "description": "Keyloop Technical Assessment - Scenario D: Unified Document Viewer (backend)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
